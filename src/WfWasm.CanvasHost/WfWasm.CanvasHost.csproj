<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <ItemGroup><EmbeddedResource Include="SyncfusionDemos.json" /><EmbeddedResource Include="DesktopBenchmarks.json" /></ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Browser demos run without debugger instrumentation. Opt in with
         -p:WasmDebugLevel=-1 when attaching a managed debugger. Keep the
         untrimmed dynamic app closure; this is independent of publishing. -->
    <WasmDebugLevel Condition="'$(WasmDebugLevel)' == ''">0</WasmDebugLevel>
    <NoWarn>$(NoWarn);0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.21" PrivateAssets="all" />
    <PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
    <!-- Full System.Configuration impl (app settings + AppSettings):
         the fork's own package reference does not flow through the
         plain rewritten-small <Reference/>, so without this only the
         facade ships and every settings touch TypeLoads. The rewriter
         retargets System.Configuration.* refs here (rev35). -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WfWasm.Shim\WfWasm.Shim.csproj" />
    <!-- GPU probe only: real WebGL2 IGlesContext binding (GpuProbe.cs). The
         Gles project stays out of WfWasm.sln; production painting untouched. -->
    <ProjectReference Include="..\WfWasm.Rendering.Gles\WfWasm.Rendering.Gles.csproj" />
    <ProjectReference Include="..\WfWasm.Renderer\WfWasm.Renderer.csproj" />
    <ProjectReference Include="..\WfWasm.Drawing\WfWasm.Drawing.csproj" />
    <ProjectReference Include="..\WfWasm.PdnCpu\WfWasm.PdnCpu.csproj" />
    <ProjectReference Include="..\Microsoft.Win32.SystemEvents\Microsoft.Win32.SystemEvents.csproj" />
    <!-- Headless System.Data.OleDb shape stub: netfx System.Data scope has no OleDb types in the browser, so typed-DataSet apps TypeLoad without it. The rewriter retargets System.Data.OleDb.* refs here (rev41). -->
    <ProjectReference Include="..\WfWasm.Data.OleDb\WfWasm.Data.OleDb.csproj" />
    <!-- Headless System.Windows.Extensions shape stub: netfx System scope has no System.Media types in the browser (the facade forwards to an unbundled assembly), so RadMessageBox et al TypeLoad without it. The rewriter retargets System.Media.* refs here. -->
    <ProjectReference Include="..\WfWasm.WindowsExtensions\WfWasm.WindowsExtensions.csproj" />
    <!-- Headless System.IO.IsolatedStorage: the browser runtime throws PlatformNotSupported for every member, so dictionary/settings flows die without it. The rewriter retargets System.IO.IsolatedStorage.* refs here. -->
    <ProjectReference Include="..\WfWasm.IsolatedStorage\WfWasm.IsolatedStorage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- EXPORT-ONLY portable repair (PUBPROGRESS-20261103-SHELL): regenerate the
         migrated fork from in-repo source via EnsureRewrittenFork.targets
         (exact publication form from origin/main 080210a). The live pinned
         inputs/winforms/rewritten-small reference is not redistributable.
         Live tree intentionally keeps the pinned ref; this file is NOT live. -->
    <Reference Include="$(RewrittenForkDll)" />
    <!-- Paint.NET ships on demand via /api/appmanifest?app=paintnet
         (see AppTransform): no bundled paint references remain. -->
  </ItemGroup>

  <Target Name="AliasPrimitives" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'System.Drawing.Primitives'">
        <Aliases>SysDrawPrimitives</Aliases>
      </ReferencePath>
      <ReferencePath Condition="'%(FileName)' == 'System.Drawing.Common'">
        <Aliases>SysDrawCommon</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <!-- A1 bundle fix: RAR resolves the WindowsBase reference to the
       browser-wasm runtime-pack facade (~6KB WebCIL in _framework). Mono
       loads it into the default ALC first, so the real copy fetched on
       demand can never displace it and Paint.NET bootstrap dies with
       TypeLoadException token 01000023 (no DependencyObject in the
       facade). Stage the full stub-transformed copy before references
       resolve, then swap it in so the pipeline's own WebCIL conversion,
       fingerprinting and boot.json integrity cover the real bytes. -->
  <!-- EXPORT-ONLY portable repair (PUBPROGRESS-20261103-SHELL): full-WindowsBase
       path is OPT-IN (-p:DesktopWasmFullWindowsBase=true), exact publication
       form from origin/main 080210a. Default clean-clone builds honor absent
       optional inputs (Paint.NET pristine closure lives outside this repo);
       enabled builds keep the strict gate. Live tree intentionally keeps the
       unconditional strict targets (DIFFS item 17); this file is NOT live. -->
  <Target Name="PrepareFullWindowsBase" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DesktopWasmFullWindowsBase)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/winforms/ensure-windowsbase-full.ps1&quot; -IntermediateDir &quot;$(IntermediateOutputPath)&quot;" />
  </Target>

  <Target Name="UseFullWindowsBase" AfterTargets="ResolveAssemblyReferences"
          Condition="'$(DesktopWasmFullWindowsBase)' == 'true'">
    <ItemGroup>
      <_WindowsBaseFacade Include="@(ReferenceCopyLocalPaths)" Condition="'%(FileName)' == 'WindowsBase'" />
      <_WindowsBaseFacadeRef Include="@(ReferencePath)" Condition="'%(FileName)' == 'WindowsBase'" />
    </ItemGroup>
    <PropertyGroup>
      <_WindowsBaseFullDll>$(IntermediateOutputPath)full-windowsbase\WindowsBase.dll</_WindowsBaseFullDll>
    </PropertyGroup>
    <Error Condition="'@(_WindowsBaseFacade->Count())' != '0' and !Exists('$(_WindowsBaseFullDll)')"
      Text="WindowsBase facade would bundle: full copy missing at $(_WindowsBaseFullDll)" />
    <ItemGroup Condition="'@(_WindowsBaseFacade->Count())' != '0' and Exists('$(_WindowsBaseFullDll)')">
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(FileName)' == 'WindowsBase'" />
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(FileName)' == 'WindowsBase'" />
      <ReferenceCopyLocalPaths Include="$(_WindowsBaseFullDll)">
        <CopyLocal>true</CopyLocal>
        <DestinationSubPath>WindowsBase.dll</DestinationSubPath>
      </ReferenceCopyLocalPaths>
      <ReferencePath Include="$(_WindowsBaseFullDll)">
        <CopyLocal>true</CopyLocal>
        <FusionName>WindowsBase</FusionName>
      </ReferencePath>
    </ItemGroup>
    <Message Condition="'@(_WindowsBaseFacade->Count())' != '0' and Exists('$(_WindowsBaseFullDll)')"
      Text="WindowsBase facade replaced with full copy ($(_WindowsBaseFullDll))" Importance="High" />
  </Target>

  <!-- Fail the build if the bundle regresses (facade back in _framework,
       or boot.json integrity desync). Parent deploys via sync-wwwroot. -->
  <Target Name="GateBundleWindowsBase" AfterTargets="Build"
          Condition="'$(DesktopWasmFullWindowsBase)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/winforms/check-bundle.ps1&quot; -Root &quot;$(TargetDir)wwwroot/_framework&quot;" />
  </Target>

  <!-- Publication portability: regenerate the migrated fork from source. -->
  <Import Project="../../scripts/winforms/EnsureRewrittenFork.targets" />
</Project>
