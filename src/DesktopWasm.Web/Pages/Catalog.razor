@page "/"
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>DesktopWasm catalog · unified shell</PageTitle>
<h1>DesktopWasm catalog</h1>
<p>Windows Forms and WPF applications, together in one library.</p>
<nav class="studios" aria-label="Demo studios">
    <a href="/app/smoke" @onclick='() => Nav.NavigateTo("/app/smoke", forceLoad: true)' @onclick:preventDefault>Windows Forms Studio</a>
    <a href="/demo/controls" @onclick='() => Nav.NavigateTo("/demo/controls", forceLoad: true)' @onclick:preventDefault>WPF Studio</a>
</nav>

<div class="filters">
    <input placeholder="Filter text" @bind="_query" @bind:event="oninput" aria-label="Filter text" />
    <select @bind="_framework" aria-label="Framework filter">
        <option value="">All frameworks</option>
        <option value="winforms">Windows Forms</option>
        <option value="wpf">WPF</option>
        <option value="mixed">Mixed (both)</option>
    </select>
    <select @bind="_status" aria-label="Input inventory filter">
        <option value="">All input records</option>
        <option value="available">Inputs cataloged</option>
        <option value="missingInput">Inputs not cataloged</option>
        <option value="notConverted">Conversion needed</option>
        <option value="unavailable">Not prepared</option>
    </select>
    <button @onclick="ReloadAsync">Apply</button>
    <button @onclick="ClearAsync">Clear</button>
</div>

@if (_loadError is not null)
{
    <div class="stage-overlay error" role="alert">
        <h2>The catalog could not load</h2>
        <p>@_loadError</p>
        <button @onclick="ClearAsync">Clear</button>
    </div>
}
else if (_apps is null)
{
    <p role="status">Loading catalog…</p>
}
else if (_apps.Count == 0)
{
    <p role="status">No apps match the current filters. <button @onclick="ClearAsync">Clear filters</button></p>
}
else
{
    <p role="status">@_apps.Count app(s).</p>
    <ul class="catalog">
        @foreach (var app in _apps)
        {
            <li>
                <strong>@app.Label</strong>
                <code>@app.Id</code>
                <span class="frameworks">@string.Join(" + ", app.Frameworks)</span>
                @if (app.Mixed) { <span class="mixed">mixed</span> }
                <span class="status">@(app.Available ? "Prepared" : app.Status == "missingInput" ? "Check availability" : app.Status == "notConverted" ? "Conversion needed" : "Not ready")</span>
                <p>@app.Description</p>
                <a href="@OpenRoute(app)" @onclick="() => Nav.NavigateTo(OpenRoute(app), forceLoad: true)" @onclick:preventDefault>Open</a>
                @if (!string.IsNullOrWhiteSpace(app.AvailabilityNote))
                {
                    <details><summary>Input inventory</summary><p class="gaps">@app.AvailabilityNote</p></details>
                }
            </li>
        }
    </ul>
}

@code {
    private List<CatalogEntry>? _apps;
    private string? _loadError;
    private string _query = "", _framework = "", _status = "";

    private static string OpenRoute(CatalogEntry app) => app.Mixed
        ? $"/launch/{app.Id}" : $"/app/{app.Id}";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loadError = null; _apps = null;
        try
        {
            var url = "api/catalog?" + string.Join("&", new[]
            {
                string.IsNullOrWhiteSpace(_framework) ? "" : $"framework={Uri.EscapeDataString(_framework)}",
                string.IsNullOrWhiteSpace(_status) ? "" : $"status={Uri.EscapeDataString(_status)}",
                string.IsNullOrWhiteSpace(_query) ? "" : $"q={Uri.EscapeDataString(_query)}",
            }.Where(p => p.Length > 0));
            _apps = await Http.GetFromJsonAsync<List<CatalogEntry>>(url) ?? [];
        }
        catch (Exception ex)
        {
            _loadError = ex.GetBaseException().Message;
        }
    }

    private async Task ClearAsync()
    {
        _query = ""; _framework = ""; _status = ""; _loadError = null;
        await ReloadAsync();
    }
}
