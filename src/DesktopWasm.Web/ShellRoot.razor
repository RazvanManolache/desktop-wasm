@using Microsoft.AspNetCore.Components.Routing
<Router AppAssembly="@typeof(ShellRoot).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
    </Found>
    <NotFound>
        <h1>Unknown page</h1>
        <p>No shell page matches this address. <a href="/">Back to the catalog</a>.</p>
    </NotFound>
</Router>
