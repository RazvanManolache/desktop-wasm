<Application x:Class="DesktopWasm.Wpf.Tests.WindowChromeApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ChromeBackground" Color="#09111F"/>
        <SolidColorBrush x:Key="ChromeForeground" Color="#F1F5F9"/>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource ChromeBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeForeground}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Application.Resources>
</Application>
