<UserControl x:Class="BootProbe.ComplexUserControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="350" Height="250">
  <Grid x:Name="RootGrid">
    <StackPanel x:Name="ContainerPanel">
      <TextBox x:Name="InputBox" Text="Sample Text" />
      <Button x:Name="ActionButton" Content="Click Me" />
      <UserControl x:Name="NestedBox">
        <TextBlock x:Name="StatusLabel" Text="All Green" />
      </UserControl>
    </StackPanel>
  </Grid>
</UserControl>
