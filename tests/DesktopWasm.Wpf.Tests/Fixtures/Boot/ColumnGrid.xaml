<Border x:Class="BootProbe.ColumnGridHost"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="300">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="Left" Width="240" MinWidth="200" MaxWidth="400"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="Top" Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <SimplePanel Grid.Column="0" Grid.Row="0" ScrollViewer.IsInertiaEnabled="True">
      <TransitioningContentControl x:Name="Host" TransitionMode="Fade"/>
    </SimplePanel>
  </Grid>
</Border>
